{
  "expo": {
    "name": "Forge",
    "slug": "forge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.forge.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Utilisé pour ajouter une photo à tes exercices personnalisés.",
        "NSPhotoLibraryUsageDescription": "Utilisé pour choisir une photo pour tes exercices personnalisés."
      }
    },
    "android": {
      "package": "com.forge.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "sounds": ["assets/sounds/timer_end.wav"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Utilisé pour choisir une photo pour tes exercices personnalisés."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
